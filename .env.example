# Oddra environment variables. Copy to `.env` (worker) or set in Vercel (web). Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to browsers: never put a secret in one.

# ---------------------------------------------------------------- network (both)
# Robinhood Chain testnet = 46630 (default). 31337 = local anvil. Mainnet (4663) is refused on purpose.
CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_ID=46630
# Comma-separated RPC endpoints; the worker fails over between them. Robinhood's public endpoint is rate-limited:
# get a dedicated one from an RPC provider that supports Robinhood Chain (e.g. Alchemy, Chainstack).
RPC_URLS=https://rpc.testnet.chain.robinhood.com
# Browser RPC (public). Defaults to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=
# Explorer: https://explorer.testnet.chain.robinhood.com (taken from the chain definition, no variable needed)

# ---------------------------------------------------------------- contracts
# Addresses default to contracts/deployments/<chainId>.json (written by `forge script script/Deploy.s.sol`).
# Set these only to override that file.
USDG_ADDRESS=
REGISTRY_ADDRESS=
TREASURY_ADDRESS=
RISK_ADDRESS=
BOOK_ADDRESS=
FEE_COLLECTOR_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_RISK_ADDRESS=
NEXT_PUBLIC_BOOK_ADDRESS=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=
# $ODRA: leave empty until the token exists and its address is verified on the explorer.
NEXT_PUBLIC_ODRA_TOKEN_ADDRESS=

# ---------------------------------------------------------------- deployment (contracts/, local shell only)
# A testnet-only key. Generate with `cast wallet new`, fund with testnet ETH from the Robinhood Chain faucet.
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=
KEEPER_ADDRESS=
# Leave empty on testnet to deploy the labelled no-value test token (real testnet USDG cannot be minted freely).
# USDG_ADDRESS=
TREASURY_SEED_USDG=250000

# ---------------------------------------------------------------- worker (persistent host only, never Vercel)
# Operator: commits, prices, locks, reveals and settles matches. Holds OPERATOR_ROLE only, no treasury rights.
OPERATOR_PRIVATE_KEY=
# Keeper: sends automatic payouts (optional; defaults to the operator key).
KEEPER_PRIVATE_KEY=
# 32 random bytes (`openssl rand -hex 32`, prefixed 0x). Derives every match's server seed. Anyone holding it can
# predict unrevealed matches: store it in your host's secret manager.
SERVER_SEED_SECRET=
# Postgres (Neon, Supabase, Railway, RDS…). Required by the worker and by the web app's history/leaderboard APIs.
DATABASE_URL=
# Simulations per fixture used for pricing (more = more accurate odds, ~0.15 s each).
PRICING_SAMPLES=200
ODDS_MARGIN=0.06
# Do not open new markets unless the treasury has this much free USDG.
MIN_FREE_LIQUIDITY_USDG=10000
PORT=8787
WORKER_ID=
LOG_LEVEL=info
# Optional: a webhook for operational alerts (Slack/Discord/PagerDuty-compatible JSON POST).
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------- web app (Vercel)
# The worker's public WebSocket feed, e.g. wss://worker.example.com/live (optional; pages replay locally without it).
NEXT_PUBLIC_LIVE_URL=
# Worker base URL for server-side health/state proxying, e.g. https://worker.example.com
WORKER_URL=
# WalletConnect Cloud project id (cloud.reown.com). Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Operations dashboard: comma-separated operator wallets, and a 32+ character random secret for session cookies.
ADMIN_ADDRESSES=
ADMIN_SESSION_SECRET=
